/data/*
# Keep small static manifests/datasets tracked despite /data/* — the
# experiments need them and they are not bulk data:
#   * data/terminus/tasks.json — TB2 task list (test-split resolution)
#   * data/swebench_train_volatile30.json(.ids.json) — the curated 30-task
#     SWE-bench train slice plus its 470-instance held-out test set
!/data/terminus/
/data/terminus/*
!/data/terminus/tasks.json
!/data/swebench_train_volatile30.json
!/data/swebench_train_volatile30.ids.json
/results/

*.zip
*.local
*.log

# SWE-bench evaluation report artifacts dumped at repo root
memomemo_candidate.*.json

references/vendor/*/.git/
references/vendor/graph-colouring/

.last_*_run_id
.last_*_pids
.last_*_pid
.last_*_ts

tests/

# harbor job outputs if a terminus run is launched from inside the vendored project
references/vendor/**/terminal_bench_2/runs/
references/vendor/**/terminal_bench_2/jobs/
