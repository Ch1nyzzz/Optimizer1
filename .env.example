# =============================================================================
# Optimizer1 secrets — Codex(Azure) comparison experiments
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in real values:
#
#     cp .env.example .env && $EDITOR .env
#
# The launch scripts source `.env` automatically. NEVER commit the real `.env`
# — this repo is public.
#
# Which keys you need depends on the experiment:
#   * Terminal-Bench  (scripts/launch_terminus_codex_azure_daytona.sh):
#       AZURE_OPENAI_API_KEY, DAYTONA_API_KEY, DEEPSEEK_API_KEY
#       runbook: docs/TERMINUS_CODEX_AZURE.md
#   * LoCoMo          (scripts/launch_locomo_codex_azure.sh):
#       AZURE_OPENAI_API_KEY, EVAL_BASE_URL / EVAL_MODEL / EVAL_API_KEY
#       runbook: docs/LOCOMO_LONGMEMEVAL_CODEX_AZURE.md
#   * LongMemEval     (scripts/launch_longmemeval_codex_azure.sh):
#       AZURE_OPENAI_API_KEY, EVAL_*, JUDGE_BASE_URL / JUDGE_MODEL / JUDGE_API_KEY
#       runbook: docs/LOCOMO_LONGMEMEVAL_CODEX_AZURE.md
# =============================================================================

# --- Codex proposer authentication (Azure OpenAI) — ALL experiments ----------
# The Codex CLI authenticates against Azure OpenAI with this key. It is
# referenced by `env_key` in ~/.codex/config.toml — copy the template at
# docs/codex_config.azure.toml there.
AZURE_OPENAI_API_KEY=replace_me

# --- Daytona cloud sandbox — Terminal-Bench experiment only ------------------
# Managed-cloud key from https://app.daytona.io  (Settings -> API Keys).
# Your account's concurrent-sandbox quota must be >= ROLLOUT_CONCURRENCY (40).
DAYTONA_API_KEY=dtn_replace_me

# --- Terminus solver (DeepSeek-V4) — Terminal-Bench experiment only ----------
# API key for the DeepSeek-V4 endpoint that drives the Terminus solver. The
# launch script's SOLVER_API_KEY_ENV defaults to DEEPSEEK_API_KEY; if you point
# the solver at a different endpoint, name its key var here and set
# SOLVER_API_KEY_ENV to match.
DEEPSEEK_API_KEY=replace_me

# --- Scaffold eval model — LoCoMo / LongMemEval experiments ------------------
# locomo / longmemeval run the agent scaffold against this model while it
# answers benchmark questions. Point it at any remote OpenAI-compatible endpoint
# you can reach. EVAL_BASE_URL / EVAL_MODEL are read as launch-script knobs;
# EVAL_API_KEY authenticates to that endpoint (leave it as-is if your endpoint
# needs no key — the launcher falls back to a placeholder).
EVAL_BASE_URL=https://your-eval-endpoint/v1
EVAL_MODEL=your-eval-model-name
EVAL_API_KEY=replace_me

# --- LongMemEval LLM judge — LongMemEval experiment only ---------------------
# LongMemEval scores answers with an LLM-as-judge. Point it at your own
# OpenAI-compatible endpoint. To skip the LLM judge entirely and use local
# token/F1 scoring instead, run the launcher with NO_LLM_JUDGE=1 and leave
# these three unset.
JUDGE_BASE_URL=https://your-judge-endpoint/v1
JUDGE_MODEL=your-judge-model-name
JUDGE_API_KEY=replace_me

# --- (optional) embedding endpoint for the organized arm's trace_similar -----
# The organized arm registers RunStore tools; one of them, `trace_similar`,
# embeds historical diffs against an OpenAI-compatible endpoint. Leave these
# unset to let that single tool degrade gracefully — every other RunStore tool
# queries the local SQLite store and works without an embedding endpoint.
# OPENAI_API_KEY=replace_me
# OPENAI_BASE_URL=https://your-embedding-endpoint/v1
# DIFF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
