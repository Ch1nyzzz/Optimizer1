# =============================================================================
# Optimizer1 secrets — Terminal-Bench Codex(Azure) × Daytona experiment
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in real values:
#
#     cp .env.example .env && $EDITOR .env
#
# The launch script `scripts/launch_terminus_codex_azure_daytona.sh` sources
# `.env` automatically. NEVER commit the real `.env` — this repo is public.
# =============================================================================

# --- Daytona cloud sandbox (the rollout backend) -----------------------------
# Managed-cloud key from https://app.daytona.io  (Settings -> API Keys).
# Your account's concurrent-sandbox quota must be >= ROLLOUT_CONCURRENCY (40).
DAYTONA_API_KEY=dtn_replace_me

# --- Codex proposer authentication (Azure OpenAI) ----------------------------
# The Codex CLI authenticates against Azure OpenAI with this key. It is
# referenced by `env_key` in ~/.codex/config.toml — copy the template at
# docs/codex_config.azure.toml there. See docs/TERMINUS_CODEX_AZURE.md.
AZURE_OPENAI_API_KEY=replace_me

# --- Terminus solver (DeepSeek-V4) -------------------------------------------
# API key for the DeepSeek-V4 endpoint that drives the Terminus solver. The
# launch script's SOLVER_API_KEY_ENV defaults to DEEPSEEK_API_KEY; if you point
# the solver at a different endpoint, name its key var here and set
# SOLVER_API_KEY_ENV to match.
DEEPSEEK_API_KEY=replace_me

# --- (optional) embedding endpoint for the organized arm's trace_similar -----
# The organized arm registers RunStore tools; one of them, `trace_similar`,
# embeds historical diffs against an OpenAI-compatible endpoint. Leave these
# unset to let that single tool degrade gracefully — every other RunStore tool
# queries the local SQLite store and works without an embedding endpoint.
# OPENAI_API_KEY=replace_me
# OPENAI_BASE_URL=https://your-embedding-endpoint/v1
# DIFF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
